{
  "name": "ips-platform",
  "version": "0.7.0",
  "private": true,
  "description": "IPS — Italy Point System. PRISM broadcast platform foundation with independent Program Renderer, Director Studio and Overlay Editor.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,CONTROLLER,OVERLAY,DIRECTOR,EDITOR -c blue,green,magenta,cyan,yellow \"npm run dev -w @ips/web\" \"npm run dev -w @ips/controller\" \"npm run dev -w @ips/overlay\" \"npm run dev -w @ips/director\" \"npm run dev -w @ips/editor\"",
    "dev:web": "npm run dev -w @ips/web",
    "dev:controller": "node scripts/sync-public-env.mjs && npm run dev -w @ips/controller",
    "dev:overlay": "npm run dev -w @ips/overlay",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:smoke": "node scripts/db-smoke.mjs",
    "public:smoke": "node scripts/project2-public-smoke.mjs",
    "project4:smoke": "node scripts/project4-smoke.mjs",
    "project5:smoke": "node scripts/project5-smoke.mjs",
    "predev": "node scripts/sync-public-env.mjs",
    "project5_1:smoke": "node scripts/project5-1-smoke.mjs",
    "project5_2:smoke": "node scripts/project5-2-smoke.mjs",
    "dev:director": "npm run dev -w @ips/director",
    "dev:editor": "npm run dev -w @ips/editor"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "@supabase/supabase-js": "^2.49.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
